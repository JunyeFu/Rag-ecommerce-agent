{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rag-commerce.invalid/evaluation/v2/case.schema.json",
  "title": "AutomatedCompetitionEvaluationCaseV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "family", "split", "turns", "media", "injected_faults", "risk_tags", "query_sha256", "expected", "provenance"],
  "properties": {
    "schema_version": {"const": 2},
    "case_id": {"type": "string", "pattern": "^[a-z_]+-[0-9]{3}$"},
    "family": {"enum": ["retrieval_exact", "retrieval_semantic", "constraint_conflict", "no_match", "multi_turn", "approval_state", "quote_evidence", "multimodal", "recovery_concurrency", "security"]},
    "split": {"enum": ["dev", "test", "challenge"]},
    "turns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "fixture_ref"],
        "properties": {
          "kind": {"enum": ["image", "audio"]},
          "fixture_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "injected_faults": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risk_tags": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "query_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "allowed_tools", "required_tools", "forbidden_tools", "requires_approval", "minimum_evidence_refs", "commercial_facts_allowed", "https_links_only"],
      "properties": {
        "outcome": {"enum": ["answer", "clarification", "no_match", "approval_required", "fail_closed", "recovered", "refuse"]},
        "allowed_tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden_tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "requires_approval": {"type": "boolean"},
        "minimum_evidence_refs": {"type": "integer", "minimum": 0},
        "commercial_facts_allowed": {"type": "boolean"},
        "https_links_only": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "license_status", "gold_status", "use_scope"],
      "properties": {
        "generator": {"const": "competition-eval-generator-v2"},
        "license_status": {"const": "project_generated"},
        "gold_status": {"const": "machine_rule_frozen"},
        "use_scope": {"const": "evaluation_only"}
      }
    }
  }
}
