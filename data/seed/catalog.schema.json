{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rag-commerce.invalid/seed/v1/catalog.schema.json",
  "title": "DevelopmentCatalogSeed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seed_id", "canonical_name_candidate", "description_candidate", "highlights", "development_rank_prior", "historical_price", "attributes", "scenarios", "image_refs", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "seed_id": {"type": "string", "minLength": 1},
    "canonical_name_candidate": {"type": "string", "minLength": 1},
    "brand_candidate": {"type": ["string", "null"]},
    "category_candidate": {"type": ["string", "null"]},
    "description_candidate": {"type": "string"},
    "highlights": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "development_rank_prior": {"type": "object", "additionalProperties": false, "required": ["rating_milli", "rating_count", "use_scope"], "properties": {"rating_milli": {"type": "integer"}, "rating_count": {"type": "integer"}, "use_scope": {"const": "development_benchmark_only"}}},
    "historical_price": {
      "type": "object", "additionalProperties": false,
      "required": ["amount_minor", "currency", "verification", "observed_at"],
      "properties": {"amount_minor": {"type": "integer"}, "currency": {"const": "CNY"}, "verification": {"const": "DEVELOPMENT_SEED_ONLY"}, "observed_at": {"type": "null"}}
    },
    "attributes": {"type": "object", "additionalProperties": {"type": "string"}},
    "scenarios": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "image_refs": {"type": "array", "items": {"type": "string", "pattern": "^images/products/"}, "uniqueItems": true},
    "provenance": {"$ref": "#/$defs/Provenance"}
  },
  "$defs": {
    "Provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_path", "source_sha256", "license_status", "use_scope"],
      "properties": {"source_path": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "license_status": {"const": "pending_review"}, "use_scope": {"const": "development_only"}}
    }
  }
}
