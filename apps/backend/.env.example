# ── 环境标识 ──
APP_ENV=development

# ── 数据库 (本地直连用 localhost，Docker 内用 postgres) ──
# pgvector 扩展会在首次启动时自动创建
DATABASE_URL=postgresql+asyncpg://shopping:shopping123@localhost:5433/shopping_agent

# ── LLM (二选一填 Key) ──
# Doubao (豆包) - 优先使用
DOUBAO_API_KEY=your_doubao_key_here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/
LLM_MODEL=ep-20260514111645-lmgt2
# DeepSeek - 降级回退
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── Embedding ──
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ── Reranker ──
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── HuggingFace 镜像（国内加速） ──
HF_ENDPOINT=https://hf-mirror.com

# ── 检索配置 ──
RETRIEVAL_TOP_K=20
RERANKER_TOP_K=10
HYBRID_SEARCH_ENABLED=true

# ── 服务 ──
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8080
CORS_ORIGINS=["*"]
MAX_UPLOAD_SIZE_MB=10

# ── 首次启动自动导入商品数据并生成向量（CI 环境可关闭） ──
AUTO_IMPORT_DATA=true

# ── Demo 模式（跳过 LLM 调用，仅检索 + 模板化回复） ──
DEMO_MODE=false
