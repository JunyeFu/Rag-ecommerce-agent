{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/rag-commerce-v3/control-index.schema.json",
  "title": "RAG Commerce V3 Three-level Control Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "control_model", "large", "medium", "small", "confirmation_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "control_model": {"const": "large_medium_small"},
    "large": {"type": "array", "minItems": 1},
    "medium": {"type": "array", "minItems": 1},
    "small": {"type": "array", "minItems": 1},
    "confirmation_policy": {"type": "object"}
  }
}
