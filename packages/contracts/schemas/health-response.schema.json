{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rag-commerce.invalid/v0.1.0/health-response.schema.json",
  "title": "HealthResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "contract_version"],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
