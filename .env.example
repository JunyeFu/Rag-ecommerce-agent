# Local-only defaults. Never place live provider, signing, or production values here.
POSTGRES_PORT=5433
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001

# V3 runtime values. Leave provider/OTLP blank unless explicitly configured.
DATABASE_URL=postgresql+psycopg://localdev@127.0.0.1:5433/ragcommerce
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=localdev
MINIO_SECRET_KEY=localdev-not-a-live-secret
MODEL_PROVIDER_MODE=fake
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
